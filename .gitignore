# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
.turbo/

# Type-check incremental output
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor
.vscode/
.idea/
.DS_Store

# Test coverage
coverage/

# Env
.env
.env.local
.env.*.local

# crimes state
# `.crimes/baseline.json` is intended to be committed — it pins the set of
# pre-existing findings that `crimes baseline check` ignores. Only regenerable
# cache state belongs here.
.crimes/cache/

# npm pack output
*.tgz

# Eval-harness OSS-fixture bodies. The `.crimes-eval-meta.json` per
# fixture IS committed; the cloned upstream body is gitignored so we
# never ship third-party source in this repo. `pnpm run evals:setup`
# materialises the body fresh at the pinned SHA.
evals/fixtures/0[2-4]-*/**
!evals/fixtures/0[2-4]-*/.crimes-eval-meta.json
# 16-recency is materialised by `pnpm run evals:setup` from
# 16-recency-template/, which IS committed — the same split as the OSS
# fixtures above, and for a sharper reason. The fixture needs its own
# `.git` so crimes' upward walk stops there rather than finding this
# repository, and a directory holding a `.git` cannot be tracked by the
# outer repo: git records it as a gitlink and silently commits none of
# the files. So the tree lives in the template and the working copy is
# generated.
#
# The history is rebuilt from RANKING_REFERENCE_DATE every run. Freezing
# it at authoring time would let the tranche ages decay past 14 days
# within a fortnight, taking the fixture's whole purpose with them.
evals/fixtures/16-recency/

# Eval replay output (per PR run, not pinned). The pinned per-version
# results under evals/results/<version>/ are committed. `--out` targets
# for re-scoring an older sample under the current scorer (see
# `evals:variance`) share the prefix and are equally disposable.
evals/replay/
evals/replay-*/
evals/diff-summary.md

# Python bytecode + virtualenvs. The repo ships Python fixtures under
# evals/fixtures/, and anything that imports them (an editor's language
# server, a stray `python -c`) leaves __pycache__ behind.
__pycache__/
*.py[cod]
.venv/

# Agent worktrees — `git worktree` checkouts of this repo.
.claude/worktrees/
