{
  "name": "evals-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Eval harness for crimes \u2014 fixture \u00d7 scenario \u00d7 agent orchestrator.",
  "license": "MIT",
  "scripts": {
    "evals": "tsx src/index.ts",
    "evals:setup": "tsx src/setup.ts",
    "evals:replay": "tsx src/replay.ts",
    "evals:diff": "tsx src/diff.ts",
    "evals:ranking": "tsx src/ranking-run.ts",
    "evals:verify-scenarios": "tsx src/verify-scenarios.ts",
    "evals:variance": "tsx src/variance.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "evals:outcomes": "python3 ../../scripts/eval-outcomes.py"
  },
  "dependencies": {
    "@crimes/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "zod": "^3.23.8"
  }
}
