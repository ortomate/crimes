{
  "name": "crimes-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "A crime scene investigator for your codebase. Built for agents, readable by humans.",
  "license": "MIT",
  "author": "Andrew Mayfield",
  "repository": {
    "type": "git",
    "url": "https://github.com/ortomate/crimes.git"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r run test:watch",
    "format": "biome format --write .",
    "format:check": "node scripts/biome.mjs format .",
    "lint": "node scripts/biome.mjs lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run build && pnpm run typecheck && pnpm run test",
    "ci": "pnpm run verify",
    "scan:example": "pnpm --filter crimes build && node packages/cli/dist/index.js scan examples/messy-ts-app",
    "scan:example:json": "pnpm --filter crimes build && node packages/cli/dist/index.js scan examples/messy-ts-app --format json",
    "smoke": "pnpm --filter crimes smoke",
    "evals": "pnpm --filter evals-runner run evals",
    "evals:setup": "pnpm --filter evals-runner run evals:setup",
    "evals:replay": "pnpm --filter evals-runner run evals:replay",
    "evals:diff": "pnpm --filter evals-runner run evals:diff",
    "evals:variance": "pnpm --filter evals-runner run evals:variance",
    "evals:verify-scenarios": "pnpm --filter evals-runner run evals:verify-scenarios",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
