{
  "$schema": "https://crimes.sh/schema/0.1.0/config.json",
  "exclude": [
    "evals/fixtures/**",
    "evals/results/**",
    "examples/messy-ts-app/**",
    "examples/risky-service/**",
    ".planning/prototypes/**",
    "docs/fixtures/**",
    "docs/superpowers/**",
    "apps/website/src/content/docs/**"
  ],
  "scopeTiers": {
    "nonDomain": [
      "scripts/**",
      "examples/**",
      "fixtures/**",
      "public/**",
      "**/__tests__/**",
      "**/*.test.{ts,tsx,js,jsx}",
      "**/*.spec.{ts,tsx,js,jsx}",
      "docs/**",
      "*.md",
      ".planning/**"
    ]
  },
  "assets": {
    "exclude": [
      "evals/fixtures/**",
      "evals/results/**",
      "examples/messy-ts-app/**",
      "examples/risky-service/**"
    ]
  }
}
