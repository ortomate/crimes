{
  "$schema": "https://crimes.sh/schema/0.1.0/config.json",
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/out/**",
    "**/coverage/**",
    "**/*.min.js",
    "**/*.generated.*",
    "**/.crimes/**",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/npm-shrinkwrap.json",
    "**/Cargo.lock",
    "**/poetry.lock",
    "**/uv.lock",
    "**/composer.lock",
    "**/*.lock",
    "**/tsconfig*.json",
    "**/pnpm-workspace.yaml",
    "evals/fixtures/**",
    "evals/results/**",
    "examples/messy-ts-app/**",
    "examples/risky-service/**",
    ".planning/prototypes/**",
    "docs/fixtures/**",
    "docs/superpowers/**",
    "apps/website/src/content/docs/**"
  ],
  "scopeTiers": {
    "nonDomain": [
      "scripts/**",
      "examples/**",
      "fixtures/**",
      "public/**",
      "**/__tests__/**",
      "**/*.test.{ts,tsx,js,jsx}",
      "**/*.spec.{ts,tsx,js,jsx}",
      "docs/**",
      "*.md",
      ".planning/**"
    ]
  },
  "assets": {
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/out/**",
      "**/coverage/**",
      "**/.crimes/**",
      "**/public/vendor/**",
      "**/__snapshots__/**",
      "**/fixtures/**",
      "**/*.test.{png,jpg,jpeg,gif,webp,avif,svg}",
      "evals/fixtures/**",
      "evals/results/**",
      "examples/messy-ts-app/**",
      "examples/risky-service/**"
    ]
  }
}
