{
  "name": "@crimes/core",
  "version": "0.0.0",
  "description": "Core detector engine, finding schema, and built-in detectors for crimes.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@crimes/language-js": "workspace:*",
    "@crimes/language-java": "workspace:*",
    "@crimes/language-jsp": "workspace:*",
    "@crimes/language-kotlin": "workspace:*",
    "@crimes/language-less": "workspace:*",
    "@crimes/language-py": "workspace:*",
    "@crimes/language-swift": "workspace:*",
    "fast-glob": "^3.3.2",
    "ignore": "^7.0.6",
    "typescript": "^5.6.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  }
}
